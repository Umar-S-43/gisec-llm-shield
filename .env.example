# LLM Server Configuration
# The llama-server URL (without trailing slash)
# Example: http://192.168.x.x:8080
LLAMA_SERVER_URL=http://localhost:8080

# Optional: Shield proxy configuration
# If running the shield proxy, set this to the shield's URL for load generators
# SHIELD_URL=http://192.168.x.x:9090

# Optional: Prometheus scrape endpoint (if monitoring llama-server metrics)
# PROMETHEUS_ENDPOINT=http://192.168.x.x:8080/metrics
