# Shield runtime log (real-time process state, not a result artifact)
shield/shield.log

# Results and data (keep .gitkeep only) — includes nested comparison run dirs
results/*.csv
results/*.json
results/**/*.csv
results/**/*.json
results/**/*.log
!results/.gitkeep

# Model weights — never commit large model files. service/download_model.py is
# the documented setup step (see service/README.md); a 1GB+ .gguf would be
# rejected outright by GitHub's 100MB per-file push limit anyway.
*.gguf

# llama.cpp binaries: llama/llama-server.exe (and its sibling DLLs) ARE committed
# on purpose so a judging checkout can run the demo without a separate llama.cpp
# build step. Do not re-add *.exe / *.dll / llama/ blanket rules here.

# OS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
